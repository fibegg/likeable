# Runtime bootstrap only. Product and integration settings live in Admin.
BASE_URL=http://localhost:5173
LIKEABLE_PUBLIC_URL=http://localhost:8080
LIKEABLE_HTTP_PORT=8080
ADMIN_EMAIL=admin@example.com
REDIS_URL=redis://localhost:6379/0
OPENAI_MODEL=gpt-5-mini

# Optional local bootstrap. In production you can set these from Admin instead.
OPENAI_API_KEY=
LIKEABLE_WORKSPACE_ROOT=

# Local/private bootstrap only. Unset after Google OAuth is configured in Admin.
LIKEABLE_DEV_AUTH=1
